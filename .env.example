# Copy to .env.local for local development. On Vercel these go in Project Settings -> Environment Variables.

# Postgres connection string. Vercel's Neon integration sets DATABASE_URL for you.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/journal

# The single password used to sign in.
APP_PASSWORD=change-me

# A long random string used to sign the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Optional. Added automatically when you create a Vercel Blob store.
# Without it, screenshots are stored in Postgres instead (4 MB each).
# BLOB_READ_WRITE_TOKEN=
